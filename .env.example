# Server configuration
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
SESSION_TTL_SECONDS=604800

# PostgreSQL is required for readiness and all persisted features.
# Use a local development database or a disposable test database.
DATABASE_URL=postgresql://jainconnect:change-me@127.0.0.1:5432/jainconnect?schema=public

# Comma-separated browser origins. Keep this an explicit allowlist.
CORS_ORIGINS=http://localhost:3000

# Public website configuration
PUBLIC_SITE_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:3001/api/v1
